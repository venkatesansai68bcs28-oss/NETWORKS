#include <stdio.h>
#include <string.h>

void twoDParity()
{
    char bits[17];
    int frame[5][5];
    int i, j, k = 0;
    int ones;
    int rErr = -1, cErr = -1;
    int choice, row, col;

    printf("\n====================================");
    printf("\n      TWO DIMENSIONAL PARITY");
    printf("\n====================================");

    printf("\nEnter 16-bit Binary Data : ");
    scanf("%s", bits);

    if(strlen(bits) != 16)
    {
        printf("\nEnter exactly 16 bits.\n");
        return;
    }

    for(i = 0; i < 16; i++)
    {
        if(bits[i] != '0' && bits[i] != '1')
        {
            printf("\nInvalid Binary Input.\n");
            return;
        }
    }

    printf("\nSender Side Matrix\n\n");

    for(i = 0; i < 4; i++)
    {
        for(j = 0; j < 4; j++)
        {
            frame[i][j] = bits[k++] - '0';
            printf("%d ", frame[i][j]);
        }
        printf("\n");
    }

    /* Row Parity Calculation */
    for(i = 0; i < 4; i++)
    {
        ones = 0;
        for(j = 0; j < 4; j++)
            ones += frame[i][j];

        frame[i][4] = ones % 2;
    }

    /* Column Parity Calculation */
    for(j = 0; j < 4; j++)
    {
        ones = 0;
        for(i = 0; i < 4; i++)
            ones += frame[i][j];

        frame[4][j] = ones % 2;
    }

    /* Overall Grand Parity */
    ones = 0;
    for(j = 0; j < 4; j++)
        ones += frame[4][j];

    frame[4][4] = ones % 2;

    printf("\nGenerated Frame\n\n");

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            printf("%d ", frame[i][j]);
            if(j == 3) printf("| ");
        }
        printf("\n");
        if(i == 3) printf("----------\n");
    }

    printf("\n1. Send Normally");
    printf("\n2. Send With Error");
    printf("\nEnter Choice : ");
    scanf("%d", &choice);

    if(choice == 2)
    {
        printf("\nEnter Row (1-5) : ");
        scanf("%d", &row);

        printf("Enter Column (1-5) : ");
        scanf("%d", &col);

        row--;
        col--;

        if(row >= 0 && row < 5 && col >= 0 && col < 5)
        {
            frame[row][col] = !frame[row][col];
            printf("\nOne Bit Modified Successfully.\n");
        }
        else
        {
            printf("\nInvalid Position.\n");
            return;
        }
    }

    /* Receiver Side Matrix Checking */
    printf("\n\n========== RECEIVER ==========\n");
    printf("\nReceived Frame\n\n");

    for(i = 0; i < 5; i++)
    {
        for(j = 0; j < 5; j++)
        {
            printf("%d ", frame[i][j]);
            if(j == 3) printf("| ");
        }
        printf("\n");
        if(i == 3) printf("----------\n");
    }

    /* Check Row Parity (Including Parity Column) */
    for(i = 0; i < 5; i++)
    {
        ones = 0;
        for(j = 0; j < 5; j++)
            ones += frame[i][j];

        if(ones % 2 != 0)
            rErr = i;
    }

    /* Check Column Parity (Including Parity Row) */
    for(j = 0; j < 5; j++)
    {
        ones = 0;
        for(i = 0; i < 5; i++)
            ones += frame[i][j];

        if(ones % 2 != 0)
            cErr = j;
    }

    printf("\n========== RESULT ==========\n");

    if(rErr == -1 && cErr == -1)
    {
        printf("\nFrame Received Successfully.\n");
        printf("Status : No Error\n");
    }
    else
    {
        printf("\nTransmission Error Found.\n");
        printf("Error Location : Row %d Column %d\n", rErr + 1, cErr + 1);
    }

    printf("\n====================================\n");
}

int main()
{
    twoDParity();
    return 0;
}

